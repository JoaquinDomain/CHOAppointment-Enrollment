# Copy this file to .env.local for local development, or to the server's
# environment file for production. Never commit real credentials.

# ---------------------------------------------------------------------------
# MySQL 8.0
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cho_app
DB_PASSWORD=replace_with_a_long_random_password
DB_NAME=cho_appointments
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
# Maximum time to wait for a pooled connection when every connection is busy.
DB_ACQUIRE_TIMEOUT_MS=15000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Either a path to a PEM file or an inline PEM certificate. Never commit the
# certificate or its private key. Required when the MICT MySQL server presents
# a private CA and DB_SSL=true.
# DB_SSL_CA=/etc/ssl/certs/mysql-ca.pem
# Verify the connection and required tables during server startup. Keep true in
# production so a misconfigured database prevents an unsafe startup.
DB_VERIFY_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Real MySQL integration tests (npm run test:db)
# ---------------------------------------------------------------------------
# Use a disposable test database, never the application database. The name
# must contain "test", "ci", or "integration", and DB_TEST_CONFIRM must be
# "yes" before the suite will drop and recreate its tables.
# DB_TEST_HOST=127.0.0.1
# DB_TEST_PORT=3306
# DB_TEST_USER=cho_app_test
# DB_TEST_PASSWORD=replace_with_a_test_only_password
# DB_TEST_NAME=cho_appointments_test
# DB_TEST_CONFIRM=yes
# DB_TEST_SSL=false
# DB_TEST_SSL_REJECT_UNAUTHORIZED=true
# DB_TEST_SSL_CA=/path/to/test-ca.pem
# DB_TEST_STRICT_PRIVILEGES=no

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin used for links and QR codes. Production MUST be HTTPS.
APP_URL=https://cho-appointment-services.bacolodcity.gov.ph
NEXT_PUBLIC_APP_URL=https://cho-appointment-services.bacolodcity.gov.ph

# At least 32 random characters. Generate with:
#   openssl rand -base64 48
APP_SECRET=replace_with_at_least_32_random_characters

# Session lifetime and booking window.
SESSION_TTL_HOURS=8
# Optional idle timeout for administrator sessions, in minutes. 0 disables it
# and keeps only the absolute SESSION_TTL_HOURS limit.
SESSION_IDLE_TIMEOUT_MINUTES=0
APPOINTMENT_BOOKING_WINDOW_DAYS=365

# Bump when the consent text changes so consent records remain traceable.
CONSENT_VERSION=v1

# Set true only when requests arrive through a trusted reverse proxy that
# overwrites X-Forwarded-For / X-Real-IP. Required for per-client rate limits.
TRUST_PROXY=true

# Must be true in production (HTTPS). Leave false for local HTTP development.
COOKIE_SECURE=true

# Optional extra allowed origins, comma-separated. The APP_URL origin is
# always allowed automatically.
# ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# Optional official ENVI System URL for health certificates. If empty, the
# service is shown as unavailable for online booking.
NEXT_PUBLIC_ENVI_URL=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (human verification for the public booking form)
# ---------------------------------------------------------------------------
# Disabled by default. When enabled, BOTH the secret key and the public site
# key must be present, otherwise the application refuses to start.
#
# TURNSTILE_SECRET_KEY is server-side only and must never be exposed to the
# browser or committed to Git. NEXT_PUBLIC_TURNSTILE_SITE_KEY is public by
# design: the browser widget needs it.
#
# TURNSTILE_ENABLED=true
# TURNSTILE_SECRET_KEY=replace_with_the_cloudflare_turnstile_secret_key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_the_cloudflare_turnstile_site_key

# ---------------------------------------------------------------------------
# Privacy notice (shown on /privacy)
# ---------------------------------------------------------------------------
# Leave blank to fall back to the Data Protection Officer contact published in
# the official privacy policy.
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_CONTACT_PHONE=
NEXT_PUBLIC_RETENTION_POLICY_SUMMARY=
