# Database provider: "supabase" (default) or "oracle"
DB_PROVIDER=supabase

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Oracle DB Configuration (required when DB_PROVIDER=oracle)
# See docs/oracle-setup.md for setup instructions.
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECT_STRING=your_oracle_connection_string
# Optional connection pool tuning
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
# Optional: set ONLY if thick mode is needed (Oracle Client libraries path)
# ORACLE_CLIENT_LIB_DIR=/path/to/instantclient

# Site URL for QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123